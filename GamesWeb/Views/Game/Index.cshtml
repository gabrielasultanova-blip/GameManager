@model IEnumerable<GamesWeb.ViewModels.Game.GameIndexViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Игри</h1>

<p>
    <a asp-action="Create">Добави нова игра</a> |

    <a asp-controller="Character"
       asp-action="Index">
        Покажи всички герои
    </a>
</p>

<table class="table">

    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.ReleaseYear)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.AgeRating)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Developer)
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseYear)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.AgeRating)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Developer)
                </td>

                <td>
                    <a asp-controller="Game"
                       asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a> |

                    <a asp-controller="Game"
                       asp-action="Details"
                       asp-route-id="@item.Id">Details</a> |

                    <a asp-controller="Game"
                       asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>
