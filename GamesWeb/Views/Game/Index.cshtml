@model IEnumerable<GamesWeb.ViewModels.Game.GameIndexViewModel>

@{
    ViewData["Title"] = "Игри";

    var genres = ViewBag.Genres as List<string>;

    if (genres == null)
    {
        genres = new List<string>();
    }

    string search;

    if (ViewBag.Search != null)
    {
        search = ViewBag.Search;
    }
    else
    {
        search = "";
    }

    string selectedGenre;

    if (ViewBag.Genre != null)
    {
        selectedGenre = ViewBag.Genre;
    }
    else
    {
        selectedGenre = "";
    }

    string selectedSort;

    if (ViewBag.SortOrder != null)
    {
        selectedSort = ViewBag.SortOrder;
    }
    else
    {
        selectedSort = "year_desc";
    }
}

<h1>Игри</h1>

<p>
    <a asp-action="Create">Добави нова игра</a> |

    <a asp-controller="Character"
       asp-action="Index">
        Покажи всички герои
    </a>
</p>

<form asp-controller="Game"
      asp-action="Index"
      method="get"
      class="mb-4">

    <div class="row g-3">

        <div class="col-md-4">
            <label for="search" class="form-label">
                Търсене по заглавие
            </label>

            <input type="text"
                   id="search"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="Въведи заглавие..." />
        </div>

        <div class="col-md-4">
            <label for="genre" class="form-label">
                Филтриране по жанр
            </label>

            <select id="genre"
                    name="genre"
                    class="form-select">

                <option value="">Всички жанрове</option>

                @foreach (var genre in genres)
                {
                    <option value="@genre"
                            selected="@(selectedGenre == genre)">
                        @genre
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label for="sortOrder" class="form-label">
                Сортиране по година
            </label>

            <select id="sortOrder"
                    name="sortOrder"
                    class="form-select">

                <option value="year_desc"
                        selected="@(selectedSort == "year_desc")">
                    От най-нова към най-стара
                </option>

                <option value="year_asc"
                        selected="@(selectedSort == "year_asc")">
                    От най-стара към най-нова
                </option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Търси
        </button>

        <a asp-controller="Game"
           asp-action="Index"
           class="btn btn-secondary">
            Изчисти
        </a>
    </div>
</form>

<hr />

<h3>Списък с игри</h3>

<p>Намерени игри: @Model.Count()</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Заглавие</th>
            <th>Жанр</th>
            <th>Година</th>
            <th>Възрастов рейтинг</th>
            <th>Разработчик</th>
            <th>Герои</th>
            <th>Действия</th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center">
                    Няма намерени игри.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Genre</td>
                    <td>@item.ReleaseYear</td>
                    <td>@item.AgeRating</td>
                    <td>@item.Developer</td>

                    <td>
                        @if (item.Characters.Any())
                        {
                            <ul>
                                @foreach (var character in item.Characters)
                                {
                                    <li>@character</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>Няма герои</span>
                        }
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id">Edit</a> |

                        <a asp-action="Details"
                           asp-route-id="@item.Id">Details</a> |

                        <a asp-action="Delete"
                           asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

